    "name": "yanwei999999",
    "email": "yanwei999999@163.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanwei999999/dsh-dog.git"
  },
  "homepage": "https://github.com/yanwei999999/dsh-dog",
  "bugs": {
    "url": "https://github.com/yanwei999999/dsh-dog/issues"
  },
  "bin": {
    "dsh-dog": "./dsh-dog.mjs"
  },
  "files": [
    "dsh-dog.mjs",
    "dsh-dog.cmd",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "deepseek",
    "plugin",
    "watchdog",
    "rollback",
